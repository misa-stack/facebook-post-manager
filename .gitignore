# Keep only application source, the main README, and this ignore file.
/*
!/.gitignore
!/README.md
!/src/

# Python environments and generated files
.venv/
docs/
packaging/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
dist/
build/
*.egg-info/

# Local tests and test output
/tests/
.coverage
.coverage.*
coverage.xml
htmlcov/
test-results/
reports/

# Environment settings and local credentials
# These rules cannot protect secrets embedded in otherwise public source files.
.env
.env.*
secrets/
.secrets/
credentials/
.credentials/
vault/
.vault/
credentials.json
credentials.toml
secrets.json
secrets.toml
app-secret
app-secret.*
app_secret
app_secret.*
user-token
user-token.*
user_token
user_token.*
page-token
page-token.*
page_token
page_token.*
new-token
new-token.*
token
token.*
tokens.json
api-key
api-key.*
api_key
api_key.*
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519

# Local databases, including encrypted tokens and personal history
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*

# Browser authentication, logs, and packaged releases
playwright/.auth/
session.json
cookies.json
*.log
logs/
*.zip
*.tar
*.tar.gz
*.tgz
*.tar.xz
*.7z

# Local agent and cloud configuration
.agents/
.codex/
.aws/
